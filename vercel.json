{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://kamilcodes14.github.io https://planet-x-sphere-x-git-integration-spacemind-universe-syed-kamil.vercel.app https://planet-x-sphere-ndyaqaksz-syed-kamil.vercel.app https://planet-x-sphere-x.vercel.app https://planet-x-sphere-x-syed-kamil.vercel.app https://planet-x-sphere-x-git-main-syed-kamil.vercel.app"
        }
      ]
    }
  ]
}
