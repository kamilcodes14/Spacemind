# Copy this file to .env and adjust as needed. All of these have sane
# defaults in src/config.py, so .env is optional unless you want to
# override something.

# Local embedding model (HuggingFace, downloaded once, runs on CPU/GPU)
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# Generation backend: "groq" (hosted, required for deployment) or "ollama"
# (local, for offline dev only — run `ollama pull llama3.2` first)
LLM_PROVIDER=groq

# Groq — free tier, no credit card. Get a key at console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_NUM_CTX=4096

# Chroma
CHROMA_COLLECTION_NAME=spacemind

# Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# Retrieval
TOP_K=5
RETRIEVE_TOP_K=15

# Re-ranking (cross-encoder, improves relevance of the retrieved chunks)
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Confidence fallback — below this similarity score, SpaceMind says
# "I don't have enough on this yet" instead of forcing a weak answer
MIN_SIMILARITY_SCORE=0.35

# OCR fallback for scanned PDFs (needs the Tesseract binary installed —
# see README; not just the Python package)
OCR_ENABLED=true
OCR_MIN_CHARS=200

# NASA ADS ingestion (optional) — free token: ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=

# Semantic Scholar ingestion (optional) — works without a key for light use;
# a key raises rate limits: semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Rate limiting on /ask, per IP per hour
RATE_LIMIT_PER_HOUR=30

# Web search — live "web knowledge" beyond your ingested papers. Free key
# (no card): https://app.tavily.com. Leave blank to disable — SpaceMind
# still works papers-only, it just won't have a web fallback.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=4

# Auto-ingest on first start — if the Chroma index is empty, SpaceMind builds it
# itself from these queries (comma-separated). Set AUTO_INGEST_ON_STARTUP=false to
# disable. Keep BOOTSTRAP_MAX_RESULTS small on free hosting.
AUTO_INGEST_ON_STARTUP=true
BOOTSTRAP_ARXIV_QUERIES=cat:astro-ph.HE,cat:astro-ph.CO
BOOTSTRAP_NTRS_QUERIES=black holes,dark matter
BOOTSTRAP_MAX_RESULTS=8
