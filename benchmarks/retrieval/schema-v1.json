{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpaceMind retrieval benchmark v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "documents",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "enum": [
        "example",
        "research"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "embedding": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "query",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "unreviewed",
              "reviewed"
            ]
          },
          "title_derived": {
            "type": "boolean"
          },
          "reviewer": {
            "type": "string"
          },
          "gold_document_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "embedding": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
