{
  "name": "spacemind",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/supabase/*.test.mjs tests/science/*.test.mjs tests/evals/*.test.mjs",
    "test:db": "node tests/supabase/database.mjs",
    "check": "node --check frontend/app.js && node --check frontend/universe.js && node --check frontend/science/lab.js && node --check supabase/functions/space-data/providers.js",
    "eval": "node scripts/evaluate.mjs",
    "eval:live": "node scripts/evaluate.mjs --live",
    "eval:fixtures": "node evals/build-fixtures-v2.mjs",
    "eval:review": "node scripts/review-evaluation.mjs",
    "eval:compare": "node scripts/compare-evaluations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "pdfjs-dist": "6.4.299",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "esbuild": "0.28.2",
    "pyodide": "314.0.7"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
