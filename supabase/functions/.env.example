# Set these with: supabase secrets set --env-file supabase/functions/.env
# Copy this file to .env first. Never commit the resulting .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-FRONTEND.vercel.app
# Generate a random 32+ character value for the operator-only import endpoint.
PAPER_IMPORT_TOKEN=
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied
# automatically to deployed functions by Supabase. Do not put service keys in frontend variables.
